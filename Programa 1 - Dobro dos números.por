programa 

{ 

	 

	funcao inicio() 

	{ 
     inteiro v[8]
     inteiro i 
     para ( i = 0; i < 8; i++)
{
	escreva ("numero ", i + 1, " ")
	leia (v[i])
           }
           para (i = 0; i < 8; i++)
           {
           	escreva ("v[", i, "] = ", v [i], " \n ")
           }
           para (i = 0; i < 8; i++)
           escreva ("v[", i, "]*2 = ",v[i]*2, " \n ")
           }
}


